# Wasabi S3-compatible object storage
# Select the endpoint that matches the bucket region.
WASABI_ENDPOINT=https://s3.ap-northeast-1.wasabisys.com
WASABI_REGION=ap-northeast-1
WASABI_BUCKET=replace-with-wasabi-bucket
WASABI_ACCESS_KEY_ID=replace-with-server-access-key
WASABI_SECRET_ACCESS_KEY=replace-with-server-secret-key

# Optional storage settings
WASABI_KEY_PREFIX=vote
WASABI_FORCE_PATH_STYLE=false
WASABI_PRESIGNED_URL_EXPIRES_IN_SECONDS=300

# Permanent SMS participation capability
# API and worker must share the same signing key and key ID.
PARTICIPATION_LINK_SIGNING_KEY=replace-with-at-least-32-byte-random-secret
PARTICIPATION_LINK_SIGNING_KEY_ID=current
PARTICIPATION_LINK_VERIFICATION_KEYS={}
PARTICIPATION_UI_URL=http://localhost:3001/participate
ORGANIZATION_INVITATION_HASH_SECRET=replace-with-at-least-32-random-characters
PARTICIPATION_ALLOWED_ORIGINS=http://localhost:3001
