AUTH_SECRET=
AUTH_URL=http://localhost:3001
AUTH_TRUST_HOST=true
AUTH_OIDC_ISSUER=http://localhost:3002
AUTH_OIDC_TENANT_CODE=e-vote
# Production: use the Auth HTTPS origin (not /t/e-vote/oidc), approved HTTPS
# AUTH_URL and API origin, and a server-only AUTH_E_VOTE_SECRET. Local defaults
# and a public client are development-only; see docs/auth-production-contract.md.
# Production AUTH_URL is https://vote.rvkang.app or https://vote-admin.rvkang.app
# per UI instance; AUTH_E_VOTE_RESOURCE is https://vote-api.rvkang.app.
AUTH_E_VOTE_RESOURCE=https://vote-api.example.com
# AUTH_E_VOTE_SECRET=
# live: 실제 Vote API/OIDC 연결, mock: 로컬 fixture/Mock 사용자 사용
NEXT_PUBLIC_VOTE_API_MODE=live
VOTE_API_BASE_URL=http://localhost:3000
VOTE_PROFILE_REGISTRATION_SECRET=change-me
NEXT_PUBLIC_VOTE_API_BASE_URL=/api/vote-server
# Only when the server and worker use BILLING_PAYMENT_MODE=toss-test.
# NEXT_PUBLIC_BILLING_PAYMENT_MODE=toss-test
# NEXT_PUBLIC_TOSS_CLIENT_KEY=test_gck_your_test_payment_widget_client_key
# Public capability requests must reach the vote server directly for its HttpOnly cookie.
NEXT_PUBLIC_PARTICIPATION_API_BASE_URL=http://localhost:3000
